<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Energy Aura behind Battery -->
    <path
        android:pathData="M34,53 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="53"
                android:gradientRadius="24"
                android:type="radial">
                <item android:color="#4010B981" android:offset="0.0" />
                <item android:color="#2006B6D4" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Battery Terminal Cap -->
    <path
        android:pathData="M48,27.5 L48,26 C48,25 48.9,24.2 50,24.2 L58,24.2 C59.1,24.2 60,25 60,26 L60,27.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="24.2"
                android:endX="60"
                android:endY="27.5"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Battery Body Dark Glass Interior -->
    <path
        android:pathData="M45,28 L63,28 C68,28 72,32 72,37 L72,71 C72,76 68,80 63,80 L45,80 C40,80 36,76 36,71 L36,37 C36,32 40,28 45,28 Z"
        android:fillColor="#0B132B" />

    <!-- Battery Charge Fluid Level (70% fill with energetic green-cyan gradient) -->
    <path
        android:pathData="M37.5,43 L70.5,43 L70.5,71 C70.5,75.5 67,78.5 63,78.5 L45,78.5 C41,78.5 37.5,75.5 37.5,71 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37.5"
                android:startY="43"
                android:endX="70.5"
                android:endY="79"
                android:type="linear">
                <item android:color="#22D3EE" android:offset="0.0" />
                <item android:color="#10B981" android:offset="0.5" />
                <item android:color="#059669" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Fluid Meniscus Line -->
    <path
        android:pathData="M38,43 L70,43"
        android:strokeColor="#A7F3D0"
        android:strokeWidth="1.5" />

    <!-- Battery Outer Frame / Chiseled Metallic Rim -->
    <path
        android:pathData="M45,28 L63,28 C68,28 72,32 72,37 L72,71 C72,76 68,80 63,80 L45,80 C40,80 36,76 36,71 L36,37 C36,32 40,28 45,28 Z"
        android:strokeWidth="2.8"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="36"
                android:startY="28"
                android:endX="72"
                android:endY="80"
                android:type="linear">
                <item android:color="#67E8F9" android:offset="0.0" />
                <item android:color="#34D399" android:offset="0.5" />
                <item android:color="#0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek Glass Specular Reflection Highlight (top-left) -->
    <path
        android:pathData="M39,46 L39,36 C39,32.5 41.5,30.5 45,30.5 L53,30.5"
        android:strokeColor="#60FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />

    <!-- Technical Level Indicator Ticks on Right -->
    <path
        android:pathData="M66,36 L69,36"
        android:strokeColor="#30FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M66,54 L69,54"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M66,71 L69,71"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />

    <!-- High-Contrast Bolt Drop Shadow for Depth -->
    <path
        android:pathData="M56.5,34 L43.5,52 L52.5,52 L49.5,72 L64.5,49 L55.5,49 Z"
        android:fillColor="#091823"
        android:strokeColor="#091823"
        android:strokeWidth="2.4"
        android:strokeLineJoin="round" />

    <!-- Modern Sharp Lightning Bolt Core -->
    <path
        android:pathData="M56,34 L44,51.5 L52.5,51.5 L49.5,71.5 L64,48.5 L55.5,48.5 Z"
        android:strokeColor="#FEF08A"
        android:strokeWidth="0.8"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="34"
                android:endX="56"
                android:endY="71.5"
                android:type="linear">
                <item android:color="#FFFBEB" android:offset="0.0" />
                <item android:color="#FDE047" android:offset="0.3" />
                <item android:color="#F59E0B" android:offset="0.8" />
                <item android:color="#D97706" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
